{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scng-aotw-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scng-aotw",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://jwilliams-scng.github.io"
  }
}
